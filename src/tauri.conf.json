{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seelen Lite",
  "identifier": "com.seelen.seelen-ui",
  "version": "../package.json",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**/*",
          "$TEMP/**/*",
          "$APPDATA/**/*",
          "$LOCALDATA/**/*",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.png",
          "**/*.webp",
          "**/*.gif",
          "**/*.svg"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "build": {
    "beforeDevCommand": "npm run build:ui -- --serve",
    "beforeBuildCommand": "npm run build:ui -- --production",
    "devUrl": "http://localhost:3579",
    "frontendDist": "../dist",
    "features": []
  },
  "bundle": {
    "active": true,
    "publisher": "Seelen",
    "category": "Utility",
    "copyright": "Copyright © 2024",
    "shortDescription": "Seelen Lite",
    "longDescription": "Seelen Lite: minimal dock and top bar for Windows (fork of Seelen UI)",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/DavidEscobar2707/Seelen-UI/tree/lite",
    "resources": {
      "static": "static"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "static/icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "static/icons/installer.ico",
        "uninstallerIcon": "static/icons/uninstaller.ico",
        "sidebarImage": "static/icons/banner.bmp",
        "template": "templates/installer.nsi",
        "installerHooks": "templates/installer-hooks.nsh",
        "installMode": "currentUser",
        "startMenuFolder": "Seelen Lite",
        "displayLanguageSelector": true,
        "languages": [
          "arabic",
          "bulgarian",
          "dutch",
          "english",
          "french",
          "german",
          "italian",
          "japanese",
          "korean",
          "norwegian",
          "portuguese",
          "portuguesebr",
          "russian",
          "simpchinese",
          "spanish",
          "swedish",
          "tradchinese",
          "turkish",
          "ukrainian",
          "vietnamese"
        ]
      }
    }
  }
}
